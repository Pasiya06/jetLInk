{
  "expo": {
    "name": "JetLink",
    "slug": "jetlink",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/JetLink.png",
    "scheme": "jetlink",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/JetLink.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jetlink.mobileapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/JetLink.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/JetLink.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#173C79"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.jetlink.mobileapp",
          "enableGooglePay": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/JetLink.png",
          "color": "#0057D9"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "86b5f4aa-8f93-463c-a4e7-c7e1de851813"
      }
    }
  }
}
