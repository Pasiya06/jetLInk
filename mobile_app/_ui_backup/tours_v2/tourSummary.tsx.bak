import React, { useEffect, useState } from "react";
import { Stack, useRouter, useLocalSearchParams } from "expo-router";
import {
  View,
  Text,
  StyleSheet,
  TouchableOpacity,
  ScrollView,
  StatusBar,
  TextInput,
  Modal,
  Alert,
  ActivityIndicator,
} from "react-native";

import { LinearGradient } from "expo-linear-gradient";

import {
  Ionicons,
  MaterialCommunityIcons,
  Feather ,  
  FontAwesome,
  Fontisto, 
} from "@expo/vector-icons";

import DateTimePicker from '@react-native-community/datetimepicker';

import FieldError from "../../../components/FieldError";
import { useFieldErrors } from "../../../utils/validation";
const API_URL = process.env.EXPO_PUBLIC_API_URL;

type Place = {
  _id: string;
  name: string;
  description: string;
  icon: string;
  iconType: string;
  color: string;
  order: number;
};

type PackageData = {
  _id: string;
  description: string;
  packageType: string;
  totalDistance: string;
  tripDuration: string;
  maxPassengers: number;
  maxPrice: number;
  places: Place[];
};

export default function PackageDetails() {
  const router = useRouter();
  const { validate: validateFields, errorFor: fieldError } = useFieldErrors();
  const params = useLocalSearchParams();
  const [pickup, setPickup] = useState(String(params.pickup || ""));
  const [time, setTime] = useState(new Date());
  const [showTimePicker, setShowTimePicker] = useState(false);
  const [selectedTime, setSelectedTime] = useState("");
  const PACKAGE_ID = params.packageId as string;
  const [packageData, setPackageData] = useState<PackageData | null>(null);
  const [places, setPlaces] = useState<Place[]>([]);
  const [loading, setLoading] = useState(true);
  
  const [activeTab, setActiveTab] = useState(''); 
  const [isSearching, setIsSearching] = useState<boolean>(false);
  const [searchQuery, setSearchQuery] = useState<string>('');

  const onTimeChange = (event: any, selected?: Date) => {
    setShowTimePicker(false);

    if (selected) {
      setTime(selected);

      const formatted = selected.toLocaleTimeString([], {
        hour: "2-digit",
        minute: "2-digit",
      });

      setSelectedTime(formatted);
    }
  };

  const tourinterface = () => {
    if (!validateFields([
      { key: "pickup", label: "Pickup location", value: pickup },
      { key: "selectedTime", label: "Pickup time", value: selectedTime },
    ])) return;

    router.push({
      pathname: "/passenger/tours/paymentGateway",
      params: {
        busNumber: params.busNumber,
        driverNIC: params.driverNIC,
        conductorNIC: params.conductorNIC,
        driverD: params.driverD,
        conductorD: params.conductorD,
        isOnline: params.isOnline,
        date: params.date,
        pickup: pickup,
        time: selectedTime,
        packageId: params.packageId,
        description: params.description,
        packageType: params.packageType,
        totalDistance: params.totalDistance,
        tripDuration: params.tripDuration,
        maxPassengers: params.maxPassengers,
        maxPrice: params.maxPrice,
        Pid: params.Pid,
        Pid1: params.Pid1,
        pfirstName: params.pfirstName,
        plastName:params.plastName,
        pphoneNumber: params.pphoneNumber,
        pemail: params.pemail,
      },
    });
  };


  

  return (
    <>
      <Stack.Screen options={{ title: "", headerShown: false }} />
      <View style={styles.container}>
        <StatusBar barStyle="light-content"/>

        {/*  HEADER  */}

        <LinearGradient
            colors={["#173C79","#155B8A","#159B79",]}
            start={{x: 0, y: 0,}}
            end={{x: 1, y: 1,}}
            style={styles.submitGradient1}
        >
            <View style={styles.header}>
                            
                <TouchableOpacity >
                    <Text style={styles.headertitle}>Tour Summary</Text>
                </TouchableOpacity>
                            
            </View>
        </LinearGradient> 


        {/*  SECTION HEADER  */}

        <View style={styles.card}>
          <View style={styles.cardHeader}>
                <View style={styles.packageTypeBadge}>
                <Text style={styles.packageTypeText}>
                    {params.packageType ||"PACKAGE"}
                </Text>
                </View>
                
                
            </View>
        
            <Text style={styles.packageName}>
                Rs {params.maxPrice}
            </Text>
        
            {!!params.description && (
                <Text style={styles.description1} numberOfLines={2}>
                {params.description}
                </Text>
            )}
        
            <View style={styles.detailsRow}>
                <View style={styles.detailItem}>
                <Ionicons name="navigate-outline" size={16} color="#159B79"/>
                <Text style={styles.detailText}>
                    {params.totalDistance || "No distance"}
                </Text>
                </View>
        
                <View style={styles.detailItem}>
                <Ionicons name="time-outline" size={16} color="#159B79" />
                <Text style={styles.detailText}>
                    {params.tripDuration || "No duration"}
                </Text>
                </View>
        
                <View style={styles.detailItem}>
                <Ionicons name="people-outline" size={16} color="#159B79"/>
                <Text style={styles.detailText}>
                    {params.maxPassengers || 0}
                </Text>
                </View>
                
            </View>
        </View>

        <View style={styles.card1} >
          <View style={styles.svw1}>          
            <View style={styles.detailRow}>        
              <View style={[styles.iconWrap, { backgroundColor: '#F5A62320' }]}>
                <Ionicons name="calendar-outline" size={18} color='#F5A623' />
              </View>
              <View style={styles.detailTextWrap}>
                <Text style={styles.detailLabel}>Date</Text>
                <Text style={styles.detailValue}>{params.date}</Text>
              </View>
            </View>
          </View>      
      </View>

      <View style={styles.card2} >
        <View style={styles.svw}>
          <Text style={styles.inputLabel}>Pick up Location</Text>  
          <View style={styles.inputWrapper}>                
            <View style={styles.inputInnerWrapper}>
             <TextInput 
              style={styles.input} 
              value={pickup}  
              placeholder="GALLE"
              onChangeText={(text) => setPickup(text.replace(/\s/g, "").toUpperCase())}
              autoCapitalize="characters"
              autoCorrect={false}
              />
            </View>
          </View>
          <FieldError message={fieldError("pickup", pickup)} />

          <Text style={styles.inputLabel}>Time</Text>
          <View style={styles.inputWrapper}>
            <TextInput style={styles.input}
              
              value={selectedTime}
              placeholder="00:00"
              editable={false}
            />

            <TouchableOpacity onPress={() => setShowTimePicker(true)}>
              <Ionicons name="time-outline" size={24} color="black" />
            </TouchableOpacity>
          </View>
          <FieldError message={fieldError("selectedTime", selectedTime)} /> 

          {showTimePicker && (
            <DateTimePicker
              value={time}
              mode="time"
              display="default"
              onChange={onTimeChange}
            />
          )}                

          

        </View>
      </View>

        {/* <ScrollView
          showsVerticalScrollIndicator={false}
          contentContainerStyle={styles.scrollContent}
        >

          
        </ScrollView> */}

        <TouchableOpacity style={styles.submitButton} onPress={tourinterface} >
          <LinearGradient
            colors={["#173C79","#155B8A","#159B79",]}
            start={{x: 0, y: 0,}}
            end={{x: 1, y: 1,}}
            style={styles.submitGradient}
          >
          <Text style={styles.submitText}>Pay</Text>
          </LinearGradient>
        </TouchableOpacity>

        {isSearching ? (
          <TextInput
            style={styles.searchBarInput}
            placeholder="Search..."
            value={searchQuery}
            onChangeText={setSearchQuery}
            autoFocus={true}
          />
        ) : null}
          
        <View style={styles.bottomNav}>
          
          <TouchableOpacity style={styles.item} onPress={() => { setActiveTab("home"); if (isSearching) {
                  setIsSearching(false); 
                }
    
                else {
                  router.push({
                    pathname: "/passenger/tours/PackagesScreen1",
                    params: {
                      Pid: params.Pid,
                      Pid1: params.Pid1,
                      pfirstName: params.pfirstName,
                      plastName:params.plastName,
                      pphoneNumber: params.pphoneNumber,
                      pemail: params.pemail,
                    },                    
                  });
                };}}>
            <Ionicons name={isSearching ? "arrow-back" : "arrow-back-outline"} size={24} color={activeTab === "home" ? "#0057D9" : "#8A8A8A"}/>
            <Text style={[styles.label1,activeTab === "home" && styles.activeLabel,]}>
              Back
            </Text>
          </TouchableOpacity>
    
          <TouchableOpacity style={styles.item} onPress={() => { setActiveTab("routes"); setIsSearching(!isSearching); }}>
            <FontAwesome name={isSearching ? "close" : "search"} size={24} color={activeTab  === "routes" ? "#0057D9" : "#8A8A8A"}/>
            <Text style={[ styles.label1,activeTab === "routes" && styles.activeLabel,]}>
              Routes
            </Text>
          </TouchableOpacity>
    
          <TouchableOpacity style={styles.centerButton} onPress={() => {setActiveTab("tickets"); router.push({
            pathname: "/passenger/index1",
            params: {
              Pid: params.Pid,
              Pid1: params.Pid1,
              pfirstName: params.pfirstName,
              plastName:params.plastName,
              pphoneNumber: params.pphoneNumber,
              pemail: params.pemail,
            },                      
          });}} > 
            <Ionicons name="home-outline" size={28} color="#fff" />             
          </TouchableOpacity>
    
          <TouchableOpacity style={styles.item} onPress={() => { setActiveTab("routes"); router.push({ pathname: "/notifications", params: { role: "passenger" } });}}>
            <Ionicons name="notifications-outline" size={24} color={activeTab === "alerts" ? "#0057D9" : "#8A8A8A"}/>
            <Text style={[styles.label1,activeTab === "alerts" && styles.activeLabel, ]}>
              Alerts
            </Text>
          </TouchableOpacity>
    
          <TouchableOpacity style={styles.item} onPress={() => {setActiveTab("profile"); router.push({ pathname: "/passenger/passengerProfile", params: { role: "passenger",NIC: params.NIC } });}}>
            <Feather name="user" size={24} color={activeTab === "profile" ? "#0057D9" : "#8A8A8A"}/>
            <Text style={[styles.label1, activeTab === "profile" && styles.activeLabel,]}>
              Profile
            </Text>
          </TouchableOpacity>
        </View>

      {/* Bottom Graphic Design Element */}
      <View style={styles.footerGraphic}>
        <LinearGradient
          colors={["#173C79","#155B8A","#159B79",]}
          start={{x: 0, y: 0,}}
          end={{x: 1, y: 1,}}
          style={styles.submitGradient}
        >
        </LinearGradient>
      </View>
      <View style={styles.footerGraphic1}>
        <LinearGradient
          colors={["#173C79","#155B8A","#159B79",]}
          start={{x: 0, y: 0,}}
          end={{x: 1, y: 1,}}
          style={styles.submitGradient}
        >
        </LinearGradient>
        </View>

      </View>
    </>
  );
}

/* STAT CARD */

function StatCard({value,label,}: {value: string;label: string;}) {
  return (
    <View style={styles.statCard}>
      <Text style={styles.statValue}>
        {value}
      </Text>

      <Text style={styles.statLabel}>
        {label}
      </Text>
    </View>
  );
}

